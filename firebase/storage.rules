rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token[role] == true;
    }

    function isAdmin() {
      return hasRole('admin') && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/adminSecurity/global).data.enabled == true
        && !firestore.get(/databases/(default)/documents/adminSecurity/global).data.blockedUids.hasAny([request.auth.uid]);
    }

    function validImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /applications/{userId}/{applicationId}/{type}/{field} {
      allow read, write: if false;
    }

    match /vendors/{userId}/menu/{menuItemId}/{fileName} {
      allow read: if true;
      allow write: if owns(userId)
        && hasRole('vendor')
        && firestore.get(/databases/(default)/documents/vendors/$(userId)).data.status == 'approved'
        && (
          (request.resource != null && validImage()
            && request.resource.metadata.ownerId == userId
            && request.resource.metadata.menuItemId == menuItemId)
          || request.resource == null
        );
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if owns(userId) || isAdmin();
      allow write: if owns(userId) && (validImage() || request.resource == null);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
